<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="340dp"
    android:layout_height="wrap_content"
    app:cardCornerRadius="16dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/gray"
        android:orientation="vertical"
        android:padding="16dp">
        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/tiny5"
                android:text="Player Stats"
                android:textColor="@color/black"
                android:textSize="22sp"
                android:textStyle="bold"/>
            <Button
                android:id="@+id/btnClose"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/icon_cancel"
                android:text="X"
                app:backgroundTint="@null"/>
        </LinearLayout>
        <!-- Stats -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="vertical">
            <TextView
                android:id="@+id/tvGamesPlayed"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/tiny5"
                android:text="Games Played: 0"
                android:textColor="@color/black"
                android:textSize="18sp"
                android:paddingVertical="8dp"/>
            <TextView
                android:id="@+id/tvGamesWon"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/tiny5"
                android:text="Games Won: 0"
                android:textColor="@color/black"
                android:textSize="18sp"
                android:paddingVertical="8dp"/>
            <TextView
                android:id="@+id/tvTilesOpened"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/tiny5"
                android:text="Tiles Opened: 0"
                android:textColor="@color/black"
                android:textSize="18sp"
                android:paddingVertical="8dp"/>

        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>